[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/tower_info_panel.gd" id="1_panel"]

[node name="TowerInfoPanel" type="CanvasLayer"]
script = ExtResource("1_panel")

[node name="Box" type="PanelContainer" parent="."]
visible = false
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2

[node name="Content" type="VBoxContainer" parent="Box"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TitleLabel" type="Label" parent="Box/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 5
theme_override_font_sizes/font_size = 26
horizontal_alignment = 1
text = "Torre"

[node name="HeaderRow" type="GridContainer" parent="Box/Content"]
layout_mode = 2
columns = 3

[node name="HeaderStat" type="Label" parent="Box/Content/HeaderRow"]
layout_mode = 2
text = ""

[node name="HeaderCurrent" type="Label" parent="Box/Content/HeaderRow"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.8, 0.8, 1)
horizontal_alignment = 1
text = "Atual"

[node name="HeaderNext" type="Label" parent="Box/Content/HeaderRow"]
layout_mode = 2
theme_override_colors/font_color = Color(0.5, 1, 0.6, 1)
horizontal_alignment = 1
text = "Upgrade"

[node name="StatsGrid" type="GridContainer" parent="Box/Content"]
layout_mode = 2
columns = 3
theme_override_constants/h_separation = 20
theme_override_constants/v_separation = 4

[node name="RangeNameLabel" type="Label" parent="Box/Content/StatsGrid"]
